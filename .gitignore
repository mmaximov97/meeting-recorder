/target
/src-tauri/target

# Tauri-оболочка: зависимости CLI и схемы прав, которые tauri-build
# перегенерирует на каждой сборке из capabilities/ и установленных плагинов.
/node_modules/
/src-tauri/gen/schemas/

# Ключи шлюза транскрипции и всё прочее локальное окружение
.env
.env.*

# Аудио не коммитим никогда, даже если каталог записей окажется внутри проекта
*.wav
*.m4a
*.mp3
*.flac
*.opus
/recordings/

# Транскрипты — тоже мимо репозитория, они уезжают в vault
*.transcript.txt
*.transcript.md

# Черновики сессий: скриншоты, логи запусков, наброски. Полезны, пока задача
# в работе, и не нужны никому после мерджа. Стенд состояний сюда не относится —
# он живёт в docs/preview/ и коммитится.
/tmp/

# Куда инструменты складывают скачанное: вложения из переписки, кадры на
# отправку, чужие файлы на посмотреть. Каталог заводится сам и наполняется
# тем, чего никто не выбирал коммитить, — включая содержимое приватных чатов.
/downloads/

# Рабочие копии, которые Claude Code заводит под изолированные задачи: каждая —
# полный чекаут репозитория внутри репозитория, сейчас их на 5 ГБ. Закрыт
# именно worktrees, а не весь /.claude/: настройки проекта там появиться могут
# и коммитятся осознанно, а вложенные чекауты — никогда.
/.claude/worktrees/

.DS_Store
Thumbs.db
