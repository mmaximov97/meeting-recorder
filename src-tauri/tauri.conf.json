{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "meeting-recorder",
  "version": "0.1.0",
  "identifier": "net.cypher-cloud.meeting-recorder",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Записи встреч",
        "width": 460,
        "height": 640,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "entitlements": null,
      "minimumSystemVersion": "11.0",
      "infoPlist": "Info.plist"
    }
  }
}
