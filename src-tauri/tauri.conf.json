{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "meeting-recorder",
  "version": "0.1.6",
  "identifier": "net.cypher-cloud.meeting-recorder",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Записи встреч",
        "width": 460,
        "height": 640,
        "resizable": true,
        "visible": false
      },
      {
        "label": "ask",
        "url": "ask.html",
        "title": "Записать встречу?",
        "width": 876,
        "height": 96,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": false,
        "focus": false,
        "focusable": false,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true,
        "visible": false,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "entitlements": null,
      "minimumSystemVersion": "11.0",
      "infoPlist": "Info.plist"
    }
  }
}
